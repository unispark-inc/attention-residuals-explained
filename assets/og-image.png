<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0f172a;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Title -->
  <text x="600" y="200" font-family="system-ui, -apple-system, sans-serif" font-size="72" font-weight="700" fill="#f1f5f9" text-anchor="middle">
    Attention Residuals
  </text>
  <text x="600" y="260" font-family="system-ui, -apple-system, sans-serif" font-size="36" fill="#cbd5e1" text-anchor="middle">
    Explained
  </text>

  <!-- Subtitle -->
  <text x="600" y="330" font-family="system-ui, -apple-system, sans-serif" font-size="24" fill="#94a3b8" text-anchor="middle">
    Replacing fixed residual connections with learned attention over depth
  </text>

  <!-- Visual elements -->
  <g opacity="0.6">
    <!-- Layer blocks -->
    <rect x="200" y="400" width="120" height="50" rx="8" fill="#8b5cf6"/>
    <rect x="380" y="400" width="120" height="50" rx="8" fill="#6366f1"/>
    <rect x="560" y="400" width="120" height="50" rx="8" fill="#3b82f6"/>
    <rect x="740" y="400" width="120" height="50" rx="8" fill="#10b981"/>

    <!-- Attention arrows -->
    <path d="M 320 400 Q 500 350 880 400" stroke="#f59e0b" stroke-width="4" fill="none" opacity="0.8"/>
    <path d="M 500 400 Q 650 360 880 400" stroke="#f59e0b" stroke-width="6" fill="none" opacity="0.8"/>
    <path d="M 680 400 Q 780 360 880 400" stroke="#f59e0b" stroke-width="8" fill="none" opacity="0.8"/>

    <!-- Output -->
    <rect x="880" y="400" width="120" height="50" rx="8" fill="#f59e0b"/>
  </g>

  <!-- Footer -->
  <text x="600" y="570" font-family="system-ui, -apple-system, sans-serif" font-size="20" fill="#64748b" text-anchor="middle">
    An Interactive Visual Explainer
  </text>
</svg>
